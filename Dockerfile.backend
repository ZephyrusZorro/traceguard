FROM python:3.12-slim
WORKDIR /app
COPY backend/pyproject.toml ./pyproject.toml
COPY backend/traceguard ./traceguard
COPY backend/scripts ./scripts
RUN pip install --no-cache-dir -e ".[mcp]" && python scripts/train_and_eval.py
EXPOSE 8000
CMD ["uvicorn", "traceguard.api.app:app", "--host", "0.0.0.0", "--port", "8000"]
